---
import type { Snippet } from '../../code/snippets';
import { getGroupSnippets } from '../../code/snippets';
import CodeTabs from './CodeTabs.astro';

interface Props {
 label?: string;
 snippets?: Snippet[];
}

const {
 label = 'Example files',
 snippets = getGroupSnippets(await Astro.slots.render('default')),
} = Astro.props;
---

<CodeTabs kind="file" label={label} snippets={snippets} />
