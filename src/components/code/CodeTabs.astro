---
import { randomUUID } from 'node:crypto';
import type { Snippet } from '../../code/snippets.server';
import { highlightSnippet } from '../../code/snippets.server';
import CodeBlock from './CodeBlock.astro';

interface Props {
 snippets: Snippet[];
 kind: 'file' | 'language';
 label: string;
 default?: string;
}

const { snippets, kind, label, default: defaultLanguage } = Astro.props;
const id = `code-${randomUUID()}`;
const blocks = snippets.map(highlightSnippet);
---

<div class="code-group" data-code-group={kind} data-default={defaultLanguage}>
 <div class="code-tabs" role="tablist" aria-label={label} hidden>
  {blocks.map((block, index) => (
   <button
    type="button"
    role="tab"
    id={`${id}-tab-${index}`}
    aria-controls={`${id}-panel-${index}`}
    aria-selected="false"
    tabindex="-1"
   >
    {block.title}
   </button>
  ))}
 </div>
 {blocks.map((block, index) => (
  <CodeBlock
   snippet={block}
   id={`${id}-panel-${index}`}
   labelledBy={`${id}-tab-${index}`}
  />
 ))}
</div>
