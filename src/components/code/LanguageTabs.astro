---
import type { Snippet } from '../../code/snippets.server';
import { getGroupSnippets } from '../../code/markdown.server';
import CodeTabs from './CodeTabs.astro';

interface Props {
 label?: string;
 default?: string;
 snippets?: Snippet[];
}

const {
 label = 'Code language',
 default: defaultLanguage,
 snippets = getGroupSnippets(await Astro.slots.render('default')),
} = Astro.props;
---

<CodeTabs kind="language" label={label} default={defaultLanguage} snippets={snippets} />
