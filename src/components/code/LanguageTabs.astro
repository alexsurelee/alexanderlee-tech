---
import type { Snippet } from '../../code/snippets.server';
import { getGroupSnippets } from '../../code/markdown.server';
import { randomUUID } from 'node:crypto';
import { highlightSnippet } from '../../code/snippets.server';
import CodeExample from './CodeExample.svelte';

interface Props {
 label?: string;
 default?: string;
 snippets?: Snippet[];
}

const {
 label = 'Code language',
 default: defaultLanguage,
 snippets = getGroupSnippets(await Astro.slots.render('default')),
} = Astro.props;
if (!snippets.length) throw new Error("Code tab groups require at least one snippet");
---

<CodeExample client:load id={`code-${randomUUID()}`} kind="language" label={label} defaultLanguage={defaultLanguage} snippets={snippets.map(highlightSnippet)} />
