---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Alexander Lee. All rights reserved.
</footer>
<style>
	footer {
		width: min(var(--site-width), calc(100% - 3rem));
		margin-inline: auto;
		padding-block: 1.5rem 2.5rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font: 0.7rem/1.8 var(--font-mono);
	}
	@media (max-width: 600px) {
		footer { width: calc(100% - 2.5rem); }
	}
</style>
