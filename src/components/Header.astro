---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">
				<span class="tab-highlight" aria-hidden="true"></span>
				Home
			</HeaderLink>
			<HeaderLink href="/blog" data-astro-prefetch="hover">
				<span class="tab-highlight" aria-hidden="true"></span>
				Blog
			</HeaderLink>
			<HeaderLink href="/about" data-astro-prefetch="hover">
				<span class="tab-highlight" aria-hidden="true"></span>
				About
			</HeaderLink>
		</div>
	</nav>
</header>
<style>
	/* Reuse the preloaded font without flashing a fallback in the site title. */
	@font-face {
		font-family: 'Charter Header';
		src: url('/fonts/charter/charter_bold.woff2') format('woff2');
		font-weight: 700;
		font-style: normal;
		font-display: block;
	}

	header {
		width: min(var(--site-width), calc(100% - 3rem));
		margin-inline: auto;
		border-bottom: 1px solid var(--rule);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1rem;
	}
	h2 { margin: 0; font-family: 'Charter Header', var(--font-body); font-size: 1.25rem; letter-spacing: -0.02em; }
	h2 a { display: inline-flex; align-items: center; min-height: 44px; }
	a { color: var(--ink); text-decoration: none; }
	.internal-links { display: flex; gap: 0.25rem; view-transition-name: header-labels; }
	.internal-links :global(a) {
		position: relative;
		isolation: isolate;
		font: 0.75rem/1.5 var(--font-mono);
		padding: 0.7rem 0.8rem;
		min-height: 44px;
		border-radius: 2px;
		color: var(--muted);
	}
	.internal-links :global(a.active) {
		color: var(--ink);
	}
	.tab-highlight {
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		pointer-events: none;
	}
	.internal-links :global(a.active) .tab-highlight {
		background: var(--highlight);
		view-transition-name: header-tab;
	}
	@media (hover: hover) {
		a:hover, .internal-links :global(a:hover) { color: var(--accent); }
	}
	@media (max-width: 600px) {
		header { width: calc(100% - 2.5rem); }
		nav { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
		.internal-links { margin-left: -0.8rem; }
	}
</style>

<style is:global>
	/* Move the background beneath a stationary snapshot of the tab labels. */
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}
	}

	::view-transition-group(header-tab) {
		z-index: 0;
		animation-duration: 140ms;
		animation-timing-function: ease-in-out;
	}

	::view-transition-group(header-labels) {
		z-index: 1;
		animation: none;
	}
	::view-transition-old(header-labels) {
		display: none;
	}
	::view-transition-new(header-labels) {
		animation: none;
		mix-blend-mode: normal;
	}

	@media (prefers-reduced-motion: reduce) {
		::view-transition-group(header-tab),
		::view-transition-old(header-tab),
		::view-transition-new(header-tab) {
			animation: none;
		}
	}
</style>
