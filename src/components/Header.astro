---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		width: min(var(--site-width), calc(100% - 3rem));
		margin-inline: auto;
		border-bottom: 1px solid var(--rule);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1rem;
	}
	h2 { margin: 0; font-size: 1.25rem; letter-spacing: -0.02em; }
	h2 a { display: inline-flex; align-items: center; min-height: 44px; }
	a { color: var(--ink); text-decoration: none; }
	.internal-links { display: flex; gap: 0.25rem; }
	.internal-links :global(a) {
		font: 0.75rem/1.5 var(--font-mono);
		padding: 0.7rem 0.8rem;
		min-height: 44px;
		border-radius: 2px;
		color: var(--muted);
	}
	.internal-links :global(a.active) {
		color: var(--ink);
		background: var(--highlight);
		view-transition-name: header-tab;
	}
	@media (hover: hover) {
		a:hover, .internal-links :global(a:hover) { color: var(--accent); }
	}
	@media (max-width: 600px) {
		header { width: calc(100% - 2.5rem); }
		nav { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
		.internal-links { margin-left: -0.8rem; }
	}
</style>

<style is:global>
	/* Keep navigation native and animate only the selected header tab. */
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}
	}

	:root {
		view-transition-name: none;
	}

	::view-transition-group(header-tab) {
		animation-duration: 140ms;
		animation-timing-function: ease-in-out;
	}

	@media (prefers-reduced-motion: reduce) {
		::view-transition-group(header-tab),
		::view-transition-old(header-tab),
		::view-transition-new(header-tab) {
			animation: none;
		}
	}
</style>
