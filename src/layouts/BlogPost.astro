---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import CodeContent from '../components/code/CodeContent.astro';
import '../styles/code.css';
import '../styles/footnotes.css';
import FloatingFootnotes from '../components/footnotes/FloatingFootnotes.svelte';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, status, createdDate, publishedDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
		{status === 'draft' && <meta name="robots" content="noindex" />}
		<style>
			main { width: min(var(--site-width), calc(100% - 3rem)); }
			.hero-image { margin-bottom: 3rem; }
			.hero-image img { display: block; width: 100%; }
			.prose { width: min(var(--content-width), 100%); margin-inline: auto; }
			.title { margin-bottom: 2.5rem; }
			.title h1 { margin-bottom: 1.5rem; }
			.date { margin-bottom: 1rem; color: var(--muted); }
			.last-updated-on { font: 0.7rem/1.8 var(--font-mono); margin-top: 0.25rem; }
			@media (max-width: 600px) {
				main { width: calc(100% - 2.5rem); }
				.hero-image { margin-bottom: 2rem; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<div class="title">
						<div class="date">
							{status === 'draft' && <strong>Draft · Created </strong>}
							<FormattedDate date={publishedDate ?? createdDate} />
							{updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<div data-article-body><CodeContent><slot /></CodeContent></div>
				</div>
			</article>
		</main>
		<Footer />

		<FloatingFootnotes client:load />

	</body>
</html>
