---
import { Image } from 'astro:assets';
import { getVisiblePosts } from '../../blog/posts.server';
import BaseHead from '../../components/BaseHead/BaseHead.astro';
import Footer from '../../components/Footer/Footer.astro';
import FormattedDate from '../../components/FormattedDate/FormattedDate.astro';
import Header from '../../components/Header/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getVisiblePosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-intro { margin-bottom: 2.5rem; }
			.page-intro p { color: var(--muted); }
			.empty-state { border-block: 1px solid var(--rule); padding-block: 1.75rem; }
			.empty-state p { margin: 0; }
			.empty-state p + p { margin-top: 0.5rem; color: var(--muted); }
			ul { list-style: none; margin: 0; padding: 0; }
			li { border-top: 1px solid var(--rule); }
			li:last-child { border-bottom: 1px solid var(--rule); }
			.post-link {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 1.5rem;
				align-items: center;
				padding-block: 1.75rem;
				color: var(--ink);
				text-decoration: none;
			}
			.post-link img { width: 112px; aspect-ratio: 1; object-fit: cover; }
			.title { font-size: 1.6rem; font-weight: 400; margin-bottom: 0.5rem; }
			.date { color: var(--muted); margin-bottom: 0.5rem; }
			.description { margin: 0; color: var(--muted); font-size: 0.9em; }
			@media (hover: hover) {
				.post-link:hover .title { color: var(--accent); text-decoration: underline; text-underline-offset: 0.2em; }
			}
			@media (max-width: 600px) {
				.post-link { gap: 1rem; }
				.post-link img { width: 72px; }
				.title { font-size: 1.35rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-intro">
				<h1>Blog</h1>
			</div>
			{posts.length === 0 ? (
				<div class="empty-state">
					<p>No posts yet.</p>
					<p><a href="/rss.xml">Subscribe via RSS</a> to catch the first one.</p>
				</div>
			) : (
				<ul aria-label="Blog posts">
					{posts.map((post) => (
						<li>
							<a class="post-link" href={`/blog/${post.id}/`}>
								<div>
									<p class="date">
										{post.data.status === 'draft' && <strong>Draft · Created </strong>}
										<FormattedDate date={post.data.publishedDate ?? post.data.createdDate} />
									</p>
									<h2 class="title">{post.data.title}</h2>
									<p class="description">{post.data.description}</p>
								</div>
								{post.data.heroImage && (
									<Image width={224} height={224} src={post.data.heroImage} alt="" />
								)}
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>
