---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I’m Alexander Lee.</h1>
			<p>Welcome to my personal website. This is where I share thoughts, notes, and things I’m learning along the way.</p>
			<p>Most of what’s here lives on the <a href="/blog/">blog</a>. You can also <a href="/about/">read more about this site</a> or <a href="/rss.xml">subscribe via RSS</a>.</p>
		</main>
		<Footer />
	</body>
</html>
