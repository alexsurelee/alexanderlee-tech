{
  "name": "alexanderlee-tech",
  "description": "Alexander Lee’s personal website and blog at alexanderlee.tech",
  "homepage": "https://alexanderlee.tech",
  "author": "Alexander Lee",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "new:post": "node --import tsx scripts/new-post.ts",
    "dev": "astro dev",
    "typecheck": "astro check",
    "build": "astro build",
    "deploy": "pnpm dlx wrangler deploy --assets ./dist --name alexanderlee-tech --compatibility-date 2026-11-04",
    "preview": "astro preview",
    "astro": "astro",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@pierre/highlights": "^0.4.0",
    "astro": "^7.4.7",
    "hast-util-from-html": "^2.1.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@effect/platform-node": "^4.1.2",
    "@emnapi/runtime": "1.11.3",
    "@storybook-astro/framework": "^1.15.0",
    "@storybook/builder-vite": "^10.6.6",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "effect": "^4.1.2",
    "happy-dom": "^21.0.4",
    "hast-util-to-html": "^9.0.6",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "storybook": "^10.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  },
  "pnpm": {
    "overrides": {
      "@napi-rs/wasm-runtime@1.2.4>@emnapi/runtime": "1.11.3"
    }
  }
}
