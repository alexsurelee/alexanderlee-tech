{
  "name": "alexanderlee-tech",
  "description": "Alexander Lee’s personal website and blog at alexanderlee.tech",
  "homepage": "https://alexanderlee.tech",
  "author": "Alexander Lee",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check",
    "build": "astro build",
    "fonts:download": "node --env-file-if-exists=.env scripts/download-fonts.mjs",
    "test:fonts": "node --test scripts/fonts.test.mjs",
    "build:production": "pnpm fonts:download && REQUIRE_LICENSED_FONTS=1 pnpm build",
    "deploy": "pnpm dlx wrangler deploy --assets ./dist --name alexanderlee-tech --compatibility-date 2026-11-04",
    "preview": "astro preview",
    "astro": "astro",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@storybook-astro/framework": "^1.15.0",
    "@storybook/builder-vite": "^10.6.6",
    "storybook": "^10.6.6",
    "typescript": "^5.9.3"
  }
}
